<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Local materials" />

    <TextView
        style="@style/BodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Install a filter in the local material center, then return it to this real Timeline and LiveWindow preview." />

    <FrameLayout
        android:id="@+id/materialPreviewStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_surface_card">

        <FrameLayout
            android:id="@+id/materialPreviewLiveWindowContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_preview_stage" />
    </FrameLayout>

    <TextView
        android:id="@+id/materialPreviewStatusText"
        style="@style/BodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_surface_card"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:padding="12dp"
        android:text="Initializing the sample Timeline preview..." />

    <TextView
        android:id="@+id/materialIntensityText"
        style="@style/BodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Filter intensity: 100%" />

    <SeekBar
        android:id="@+id/materialIntensitySeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:max="100"
        android:progress="100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/openMaterialCenterButton"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Open material center" />

        <Button
            android:id="@+id/removeFilterButton"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Remove filter" />
    </LinearLayout>
</LinearLayout>
