<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/editorStatusText"
        style="@style/BodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/editor_building" />

    <FrameLayout
        android:id="@+id/editorPreviewStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_preview_stage"
        android:padding="8dp">

        <FrameLayout
            android:id="@+id/editorLiveWindow"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_live_window" />

        <TextView
            android:id="@+id/editorEmptyPreviewText"
            style="@style/BodyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/editor_empty_preview"
            android:visibility="gone" />

        <TextView
            android:id="@+id/projectAspectText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_button_tool"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/timelineSummaryText"
            style="@style/SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editor_track" />

        <TextView
            android:id="@+id/timelineTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/editor_time_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/timelineClipScrollView"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@drawable/bg_surface_card"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/timelineClipStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/voiceoverTrackText"
            style="@style/BodyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editor_voiceover_empty" />

        <Button
            android:id="@+id/previewVoiceoverButton"
            style="@style/EditorToolButton"
            android:layout_width="88dp"
            android:layout_height="38dp"
            android:enabled="false"
            android:text="@string/editor_preview_voiceover" />

        <Button
            android:id="@+id/deleteVoiceoverButton"
            style="@style/EditorToolButton"
            android:layout_width="88dp"
            android:layout_height="38dp"
            android:layout_marginLeft="5dp"
            android:enabled="false"
            android:text="@string/editor_delete_voiceover" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/appliedMaterialsSummaryText"
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:text="@string/editor_applied_materials_empty"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/appliedMaterialStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/playButton"
            style="@style/SecondaryButton"
            android:layout_width="74dp"
            android:layout_height="46dp"
            android:text="@string/editor_play" />

        <SeekBar
            android:id="@+id/timelineSeekBar"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:progressTint="@color/brand_primary"
            android:thumbTint="@color/brand_accent" />

        <Button
            android:id="@+id/exportButton"
            style="@style/PrimaryButton"
            android:layout_width="84dp"
            android:layout_height="46dp"
            android:text="@string/editor_export" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="4dp"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addMediaButton"
                style="@style/EditorToolButton"
                android:layout_width="112dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_add_media" />

            <Button
                android:id="@+id/splitButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_split" />

            <Button
                android:id="@+id/selectClipButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_select" />

            <Button
                android:id="@+id/trimClipButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_trim" />

            <Button
                android:id="@+id/deleteClipButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_delete" />

            <Button
                android:id="@+id/moveClipButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_move" />

            <Button
                android:id="@+id/undoButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_undo" />

            <Button
                android:id="@+id/redoButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_redo" />

            <Button
                android:id="@+id/filterButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_filter" />

            <Button
                android:id="@+id/captionButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_caption" />

            <Button
                android:id="@+id/stickerButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_sticker" />

            <Button
                android:id="@+id/transitionButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_transition" />

            <Button
                android:id="@+id/musicButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_music" />

            <Button
                android:id="@+id/voiceoverButton"
                style="@style/EditorToolButton"
                android:layout_width="82dp"
                android:layout_height="46dp"
                android:layout_marginRight="6dp"
                android:text="@string/editor_voiceover" />

            <Button
                android:id="@+id/editorMaterialsButton"
                style="@style/EditorToolButton"
                android:layout_width="76dp"
                android:layout_height="46dp"
                android:text="@string/editor_assets" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
